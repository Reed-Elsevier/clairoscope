# Copy to .env and fill in. Verify with:  python scripts/check_llm.py
# Leave everything empty to run in deterministic mode (no LLM; clearly labelled in the UI).

# ---- Core: Claude on Amazon Bedrock ---------------------------------------------------------
AUDITOR_LLM=bedrock
# Verified on the team's account (2026-10-09): key scoped to Sydney; only InvokeModel models enabled.
# Opus 5.5 / the Bedrock Messages endpoint returned 'not available for this account'.
AWS_REGION=ap-southeast-2
AUDITOR_BEDROCK_MODEL=global.anthropic.claude-opus-4-6-v1
# mantle = Bedrock Messages endpoint (bedrock-mantle.<region>.api.aws), invoke = InvokeModel (bedrock-runtime)
# auto picks invoke for inference-profile / ARN / versioned IDs such as global.anthropic.claude-opus-4-6-v1
AUDITOR_BEDROCK_API=auto

# Auth: use ONE of the following
#  (a) the AWS credential chain: aws sso login / aws configure, or AWS_PROFILE=<profile>, or an EC2/ECS role
AWS_PROFILE=
#  (b) static keys from the event's AWS account
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#  (c) a Bedrock bearer token (API key)
AWS_BEARER_TOKEN_BEDROCK=

# Optional: model to retry with if a request is declined (Bedrock has no server-side fallback)
AUDITOR_FALLBACK_MODEL=
# low | medium | high. medium keeps live-demo latency down
AUDITOR_EFFORT=medium

# ---- Alternatives ------------------------------------------------------------------------------
# AUDITOR_LLM=claude   ->  ANTHROPIC_API_KEY=...   AUDITOR_CLAUDE_MODEL=claude-opus-5-5
# AUDITOR_LLM=openai   ->  OPENAI_API_KEY=...      AUDITOR_OPENAI_MODEL=<a model your account has>
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Web app / AWS ---------------------------------------------------------------------------
# Browser login (user:password); strongly recommended on any public URL
AUDITOR_BASIC_AUTH=
# Container start: download Parquet data from S3 if ./data is empty (s3://bucket/prefix)
AUDITOR_DATA_S3_URI=
# Decision ledger location (mount a volume here on AWS to keep decisions across restarts)
AUDITOR_STATE_DIR=
# Where the extracted Parquet files live (default ./data)
AUDITOR_DATA_DIR=
